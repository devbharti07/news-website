# Chronicle Global Frontend Environment Configuration

# Production / Deployed API Base URL
# Point this to your publicly accessible backend deployment (e.g. Render, Railway, or VPS)
# When deploying to Vercel, add this in Project Settings -> Environment Variables.
#
# Examples:
#   VITE_API_BASE_URL=https://chronicle-global-api.onrender.com/api
#   VITE_API_BASE_URL=https://your-backend.up.railway.app/api
#
# Note: For local development, leave this empty to use Vite's built-in proxy (/api -> localhost:5000)
VITE_API_BASE_URL=
