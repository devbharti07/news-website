# Chronicle Global Express Server Configuration

# Port to bind (assigned automatically by Render/Railway via process.env.PORT)
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated for multiple origins, e.g. Vercel production + preview)
# In production, set to your Vercel deployment URL (e.g. https://chronicle-global.vercel.app)
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Cache Configuration (TTL in seconds, default: 300 = 5 minutes)
CACHE_TTL=300

# Fallback & Mock Setting (keep false for production genuine news delivery)
USE_MOCK_NEWS=false

# Optional API Keys (Leave empty to use automatic legitimate RSS/public feeds from 45 newsrooms)
# NewsAPI (https://newsapi.org)
NEWS_API_KEY=

# The Guardian Open Platform (https://open-platform.theguardian.com)
GUARDIAN_API_KEY=

# GNews API (https://gnews.io)
GNEWS_API_KEY=

# MediaStack API (https://mediastack.com)
MEDIASTACK_API_KEY=
