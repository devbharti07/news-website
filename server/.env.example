# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Cache Configuration (TTL in seconds, default: 300 = 5 minutes)
CACHE_TTL=300

# Fallback & Mock Setting (set to true only for development offline testing)
USE_MOCK_NEWS=false

# Optional API Keys (Leave empty to use automatic legitimate RSS/public feeds)
# NewsAPI (https://newsapi.org)
NEWS_API_KEY=

# The Guardian Open Platform (https://open-platform.theguardian.com)
GUARDIAN_API_KEY=

# GNews API (https://gnews.io)
GNEWS_API_KEY=

# MediaStack API (https://mediastack.com)
MEDIASTACK_API_KEY=
